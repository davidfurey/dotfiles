#!/bin/bash

DIR=${1%/}

# Skip branches whose upstream is gone (normally merged and deleted on the remote)
git -C "$DIR" for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads 2>/dev/null |
  awk '$2 != "[gone]" {print $1}' |
  while read -r branch; do
    # --no-walk doesn't propagate --not to ancestors, so check reachability explicitly
    if [ -n "$(git -C "$DIR" rev-list -n1 "refs/heads/$branch" --not --remotes)" ]; then
      git -C "$DIR" log -1 --format="$DIR %h ($branch) %s" "refs/heads/$branch"
    fi
  done
